# ─────────────────────────────────────────────────────────────
#  Frontend environment - copy to .env and fill in
#
#      cp .env.example .env
#
#  Every VITE_* value is inlined into the JavaScript bundle at BUILD time,
#  so all of them are readable by anyone who opens the site. That is fine for
#  the values below - they are public client identifiers - but never put a
#  server-side secret in this file.
#
#  Leave everything blank and the app still runs: Google sign-in disables
#  itself with a message on the button, and the map falls back to manual
#  address entry.
# ─────────────────────────────────────────────────────────────

# Where the API lives. Leave blank in development: vite.config.js proxies
# /api to http://localhost:5000, and in Docker nginx serves the API from this
# same origin, so relative paths resolve either way.
VITE_API_BASE_URL=

# Google Maps JavaScript API key - address autocomplete and the delivery pin.
# Restrict it by HTTP referrer in the Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase web config - Google Sign-In only. Copy these from
# Firebase console -> Project settings -> Your apps -> SDK setup and config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: point the dev proxy somewhere other than http://localhost:5000
VITE_API_PROXY_TARGET=
