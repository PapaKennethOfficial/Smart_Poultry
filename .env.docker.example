# ═════════════════════════════════════════════════════════════════════════════
#  SmartPoultry — Docker environment
#
#      cp .env.docker.example .env
#
#  This file sits beside docker-compose.yml and is the ONLY .env compose reads.
#  The per-service .env files (smartpoultry-backend/.env, smartpoultry-ai/.env)
#  are for running those services directly on your machine; they are excluded
#  from the images by .dockerignore and are ignored here.
#
#  .env is already covered by .gitignore. Do not commit it.
# ═════════════════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Compose refuses to start without the first three. There are no defaults on
# purpose - a stack must never come up on a password published in a repo.

# Database password.
POSTGRES_PASSWORD=change_me

# Signs every JWT. Generate with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_64_char_hex_string

# Shared secret between the Node backend and the Python AI service. It must be
# IDENTICAL in both, which is why compose injects this one value into each.
# Generate with:  openssl rand -base64 48
AI_SERVICE_API_KEY=change_me_to_a_long_random_string

# Seeds the initial admin account (prisma/seed.js). Only needed when you run
# with RUN_SEED=true - see section 2 of DOCKER.md.
ADMIN_PASSWORD=change_me


# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=smartpoultry_db
# 5433 on the host so it cannot collide with a postgres already installed
# locally. Inside the compose network the port is still 5432.
POSTGRES_HOST_PORT=5433


# ── Host ports ───────────────────────────────────────────────────────────────
PWA_HOST_PORT=8080
ADMIN_HOST_PORT=8081
BACKEND_HOST_PORT=5000


# ── Origins ──────────────────────────────────────────────────────────────────
# Socket.IO validates the browser's Origin header against this list. Both
# frontends must appear or live delivery tracking silently fails to connect.
# Update these if you change the host ports above.
SOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
CLIENT_URL=http://localhost:8080
FRONTEND_URL=*


# ── Frontend build args ──────────────────────────────────────────────────────
# IMPORTANT: Vite inlines every VITE_* value into the JavaScript bundle at
# BUILD time. Changing one here requires a rebuild:
#
#     docker compose up --build pwa admin
#
# Leave the two API base URLs blank. Each frontend's nginx proxies /api to the
# backend on the same origin, so axios' relative paths already resolve.
PWA_API_BASE_URL=
ADMIN_API_BASE_URL=

# Google Maps JavaScript API key - powers address autocomplete and the delivery
# pin in the cart. Restrict it by HTTP referrer in the Google Cloud console:
# this value is visible in the shipped bundle, as every browser Maps key is.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase web config - used for Google Sign-In only. These are public client
# identifiers, not secrets. Leave blank to disable Google sign-in; the app
# falls back to email/password and the button says so.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Groq powers the morning briefing, Ask-the-Data and the per-chart explanations.
# Without it those endpoints return 503 with a clear message; forecasting and
# every chart still work.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

FORECAST_HISTORY_DAYS=180
FORECAST_DEFAULT_HORIZON=14
AI_SERVICE_TIMEOUT=45000


# ── Analytics constants ──────────────────────────────────────────────────────
# Feed conversion is a MASS ratio, so egg count has to be converted to mass.
# 0.06 kg is a reasonable layer average - set it to your flock's real figure.
AVG_EGG_MASS_KG=0.06
FCR_BENCHMARK=2.3
# Standard deviations from the trailing mean before a metric is flagged.
ANOMALY_SIGMA=2
# Depot the delivery routing solves from. Default is Accra.
FARM_DEPOT_LAT=5.6037
FARM_DEPOT_LON=-0.1870
REPORT_NARRATION_GAP_MS=1500


# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Weekly Prophet retrain. Cron is evaluated in TZ below - Monday 03:00.
WEEKLY_RETRAIN_ENABLED=true
WEEKLY_RETRAIN_CRON=0 3 * * 1
TZ=Africa/Accra


# ── Start-up behaviour ───────────────────────────────────────────────────────
# Applies committed Prisma migrations on every boot. Safe to leave on: it never
# generates or resets, only applies what is already in prisma/migrations.
RUN_MIGRATIONS=true

# Set to true for ONE run to populate demo data on a fresh database, then set
# it back to false. It writes rows; it is not idempotent by design.
RUN_SEED=false


# ── Optional: server-side integrations ───────────────────────────────────────
# All optional. Blank means the feature is off, not that the app breaks.

# Firebase Admin - verifies Google Sign-In tokens server-side. Needs BOTH the
# project id and a service-account file mounted into the container; see
# DOCKER.md for the extra volume line.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Email (password reset, OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (OTP delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
