# ─────────────────────────────────────────────────────────────
#  SmartPoultry AI Microservice — Environment Variables Template
#
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in the values for your local environment
#    3. Never commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Read-only PostgreSQL connection string; same DB as the Node backend.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/smartpoultry_db

# ── Server ────────────────────────────────────────────────────
# Port the FastAPI service listens on
PORT=8000
# Host binding — 0.0.0.0 for containers, 127.0.0.1 for local-only
HOST=127.0.0.1

# ── API Key Security ─────────────────────────────────────────
# Long random string shared with the Node backend. The Node gateway
# sends this in the `X-API-Key` header on every request; the AI service
# rejects any request that doesn't match.
# Generate one with: py -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_API_KEY=change_me_to_a_long_random_string

# ── CORS ──────────────────────────────────────────────────────
# Node backend origin — the only trusted caller in dev
NODE_BACKEND_ORIGIN=http://localhost:5001

# ── Forecast tuning ──────────────────────────────────────────
# How many days of historical data to feed Prophet
FORECAST_HISTORY_DAYS=180
# Default horizon in days when the client doesn't specify
FORECAST_DEFAULT_HORIZON=14
# Path (relative to smartpoultry-ai/) where trained models are stored
MODEL_CACHE_DIR=app/models/cache

# ── LLM (Groq) ───────────────────────────────────────────────
# Get one at https://aistudio.google.com/apikey
# Leave blank until Phase B; the /insights endpoints will 503 without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
