# ─────────────────────────────────────────────────────────────
#  SmartPoultry Backend — Environment Variables Template
#
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in the values for your local environment
#    3. Never commit .env to version control
# ─────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/smartpoultry"


# ── Authentication ────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens
# Use a long, random string (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="your_jwt_secret_here"

# Password assigned to the bootstrap admin user when running `npm run db:seed`.
# Required — the seed script fails fast if this is missing.
ADMIN_PASSWORD="change_me_before_seeding"



# ── Server ────────────────────────────────────────────────────
# Port the Express API server listens on (default: 5000)
PORT=5000


# ── CORS ──────────────────────────────────────────────────────
# URL of the frontend client — used to allow cross-origin requests
CLIENT_URL="http://localhost:5173"


# ── AI Microservice (smartpoultry-ai) ────────────────────────
# The Python FastAPI service exposes /api/v1/forecast/demand and
# /api/v1/routes/optimize. Set these to enable /api/ai/* endpoints
# in the Node backend. Leave AI_SERVICE_URL blank to disable — the
# gateway will return 503 with a clear message.
AI_SERVICE_URL="http://localhost:8000"
# Shared secret. MUST match AI_SERVICE_API_KEY in smartpoultry-ai/.env
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AI_SERVICE_API_KEY="change_me_to_match_ai_service"
AI_SERVICE_TIMEOUT="45000"

# Farm depot coordinates — used when /api/ai/routes/optimize is called
# with just { orderIds }. Set to your farm's own lat/lon.
FARM_DEPOT_LAT="5.6037"
FARM_DEPOT_LON="-0.1870"
