// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  WORKER
  DELIVERY
  CUSTOMER
}

enum DeliveryStaffStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum BatchStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum DeliveryType {
  FEED
  MEDICATION
  EQUIPMENT
  OTHER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportType {
  WEEKLY
  MONTHLY
  BATCH_SUMMARY
  MORTALITY
  CUSTOM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                      String   @id @default(cuid())
  name                    String
  email                   String   @unique
  password                String
  phone                   String?
  avatarUrl               String?
  role                    Role     @default(WORKER)
  deliveryStaffStatus     DeliveryStaffStatus?
  isTwoFactorEnabled      Boolean  @default(false)
  otpCode                 String?
  otpExpiry               DateTime?
  notificationPreferences Json     @default("{}")
  lastLoginAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  farms     Farm[]
  logEntries LogEntry[]
  deliveries Delivery[]
  alerts    Alert[]
  reports   Report[]
  auditLogs AuditLog[]
  vehicle   Vehicle?
  verifiedVehicles Vehicle[] @relation("VehicleVerifier")
  deliveryOrders DeliveryOrder[]
  assignedDeliveries DeliveryOrder[] @relation("DriverOrders")
  notifications UserNotification[]
  deliveryMessages DeliveryMessage[]
  reviews   Review[]
  wishlists Wishlist[]
}

model Farm {
  id        String   @id @default(cuid())
  name      String
  location  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner     User       @relation(fields: [userId], references: [id])
  batches   Batch[]
  deliveries Delivery[]
  alerts    Alert[]
  reports   Report[]
}

model Batch {
  id           String      @id @default(cuid())
  batchNumber  String
  farmId       String
  breed        String
  initialCount Int
  currentCount Int
  status       BatchStatus @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  farm       Farm       @relation(fields: [farmId], references: [id])
  logEntries LogEntry[]
  alerts     Alert[]
}

model LogEntry {
  id                 String   @id @default(cuid())
  batchId            String
  userId             String
  date               DateTime @default(now())
  mortality          Int      @default(0)
  eggsCount          Int      @default(0)
  dailyEggPurchases  Int      @default(0)
  weeklyEggPurchases Int      @default(0)
  birdsBought        Int      @default(0)
  feedConsumption    Float    @default(0)
  waterConsumption   Float    @default(0)
  avgWeight          Float?
  temperature        Float?
  humidity           Float?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  // Relations
  batch  Batch @relation(fields: [batchId], references: [id])
  loggedBy User  @relation(fields: [userId], references: [id])

  @@index([batchId, date])
  @@index([userId])
}

model Delivery {
  id           String       @id @default(cuid())
  farmId       String
  userId       String
  type         DeliveryType
  supplier     String?
  quantity     Float
  unit         String
  deliveryDate DateTime
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  farm       Farm @relation(fields: [farmId], references: [id])
  receivedBy User @relation(fields: [userId], references: [id])
}

model Alert {
  id         String        @id @default(cuid())
  farmId     String
  batchId    String?
  userId     String
  type       String
  message    String
  severity   AlertSeverity @default(LOW)
  isResolved Boolean       @default(false)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  farm      Farm   @relation(fields: [farmId], references: [id])
  batch     Batch? @relation(fields: [batchId], references: [id])
  createdBy User   @relation(fields: [userId], references: [id])
}

model Report {
  id        String     @id @default(cuid())
  farmId    String
  userId    String
  type      ReportType
  title     String
  content   Json
  fileUrl   String?
  format    String?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  farm        Farm @relation(fields: [farmId], references: [id])
  generatedBy User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([farmId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  endpoint  String?
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ─── Delivery Orders (Customer Sales) ─────────────────────────────────────────

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model DeliveryOrder {
  id            String         @id @default(cuid())
  orderId       String         @unique                  // "DEL-2026-001"
  customerId    String
  productId     String
  quantity      Int
  driverId      String?
  deliveryDate  DateTime
  address       String?
  amount        Float
  contactNumber String?
  paymentMethod String         @default("PAY_ON_DELIVERY")
  paymentStatus String         @default("PENDING")
  notes         String?
  status        DeliveryStatus @default(PENDING)
  statusHistory Json           @default("[]")           // [{status, timestamp}]
  deliveryLatitude  Float?
  deliveryLongitude Float?
  driverLatitude    Float?
  driverLongitude   Float?
  driverLocationUpdatedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  customer      User     @relation(fields: [customerId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  driver        User?    @relation("DriverOrders", fields: [driverId], references: [id])
  messages      DeliveryMessage[]
  review        Review?

  @@index([customerId])
  @@index([driverId])
  @@index([productId])
  @@index([status])
  @@index([deliveryDate])
  @@index([paymentStatus])
  @@index([paymentMethod])
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Float
  unit        String   @default("kg")
  stock       Int      @default(0)
  category    String   @default("General")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      DeliveryOrder[]
  reviews     Review[]
  wishlists   Wishlist[]
}

model Vehicle {
  id                      String   @id @default(cuid())
  user_id                 String   @unique
  make                    String
  model                   String
  year_of_manufacture     Int
  license_plate           String?
  vin                     String?
  color                   String
  vehicle_type            String
  driver_contact_number   String   @default("")
  driver_residential_address String @default("")
  driver_license_number   String
  license_expiration      DateTime
  vehicle_photo           String?
  registration_document   String?
  driver_photo            String?
  is_active               Boolean  @default(true)
  verification_status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  verification_notes      String?
  verified_by             String?
  verified_at             DateTime?
  rejection_reason        String?
  changes_requested       String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [user_id], references: [id])
  verifier                User?    @relation("VehicleVerifier", fields: [verified_by], references: [id])
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

model DeliveryMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  order     DeliveryOrder @relation(fields: [orderId], references: [id])
  sender    User          @relation(fields: [senderId], references: [id])

  @@index([orderId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  productId  String
  customerId String
  rating     Int      // 1 to 5
  comment    String?
  createdAt  DateTime @default(now())

  order    DeliveryOrder @relation(fields: [orderId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])
  customer User          @relation(fields: [customerId], references: [id])

  @@index([productId])
  @@index([customerId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

